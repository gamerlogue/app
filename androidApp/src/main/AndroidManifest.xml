<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- AUTHENTICATE_ACCOUNTS was removed in API 23 and GET_ACCOUNTS is not required from API 26 for accounts owned
         by this app, which is the only kind it reads (minSdk is 26). -->

    <!-- Write access is kept only where saving an image to the gallery needs it (Android 8-9); from Android 10
         MediaStore needs no permission. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="Gamerlogue"
        android:theme="@style/AppTheme">
        <activity
            android:name=".AppActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Legacy fallback while the verified App Link is being deployed. PKCE makes an intercepted
                 authorization code unusable, but remove this filter after the https link is verified. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="gamerlogue" android:host="auth" android:path="/callback" />
            </intent-filter>

            <!-- Verified App Link for the official instance. The native login requests this callback;
                 Android opens it directly only after assetlinks.json verifies the installed package.

                 The host is hardcoded on purpose. `autoVerify` is resolved at install time against the
                 hosts declared here, so a verified App Link can never cover a user-configured backend —
                 self-hosted instances need a loopback redirect (RFC 8252) instead, which is what the
                 desktop handler already does. Deriving this from a build property would only couple the
                 official app's identity to whoever compiles it. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="gamerlogue.maicol07.it" android:path="/auth/callback" />
            </intent-filter>
        </activity>

        <!-- Authenticator Service -->
        <service
            android:name=".auth.GamerlogueAuthenticatorService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCOUNT_AUTHENTICATOR">
            <intent-filter>
                <action android:name="android.accounts.AccountAuthenticator" />
            </intent-filter>
            <meta-data
                android:name="android.accounts.AccountAuthenticator"
                android:resource="@xml/authenticator" />
        </service>
    </application>

</manifest>
