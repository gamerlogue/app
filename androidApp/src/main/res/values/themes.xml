<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- windowBackground matches the Compose surface color so the cold-start window does not flash. -->
    <!-- AppCompat rather than the framework theme: AppCompatActivity refuses to start without it. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>
</resources>
