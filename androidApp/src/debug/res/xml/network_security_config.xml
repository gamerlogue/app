<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Any host, not just 10.0.2.2: a backend on a LAN address (192.168.x.x) is served over plain HTTP too, and
         domain-config cannot express address ranges. -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
