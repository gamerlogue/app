<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext to local backends is a debug-only affordance: keeping the config out of src/main means release
     builds cannot opt into cleartext at all. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Local Network Protections (API 37+) block LAN destinations, the emulator host alias 10.0.2.2 included, for
         apps without this runtime permission. Debug only — the released app talks to a public host. Requested by
         LocalNetworkAccess when the server URL points at a LAN host, and granted on install*Debug by the
         grantLocalNetworkAccess Gradle task. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <application android:networkSecurityConfig="@xml/network_security_config" />

</manifest>
