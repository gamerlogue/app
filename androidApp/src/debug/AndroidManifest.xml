<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext to the emulator host alias is a debug-only affordance: keeping the config out of src/main means release
     builds cannot opt into cleartext at all. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Local Network Protections (API 36+) block RFC 1918 destinations for apps that do not hold this runtime
         permission, and the emulator host alias 10.0.2.2 falls in 10/8: without it every request to a local backend
         dies with a connect timeout while adb shell reaches the same address fine. Debug only — the released app
         talks to a public host. Granted after install by the grantLocalNetworkAccess Gradle task, or requested at launch by
         AppActivity when the install skipped it. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <application android:networkSecurityConfig="@xml/network_security_config" />

</manifest>
